{
  "description": "Monorepo for Veil projects (react-veil library and docs)",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "^6.0.3"
  },
  "name": "veil-monorepo",
  "private": true,
  "scripts": {
    "build:docs": "npm run build --workspace=docs",
    "build:lib": "npm run build --workspace=react-veil",
    "dev:docs": "npm run dev --workspace=docs",
    "lint": "eslint .",
    "test": "npm test --workspace=react-veil",
    "typecheck": "npm run typecheck --workspace=react-veil && npm run typecheck --workspace=docs",
    "check": "npm run build:lib && npm run lint && npm run typecheck && npm test && npm run build:docs"
  },
  "type": "module",
  "version": "0.1.3",
  "workspaces": [
    "docs",
    "react-veil"
  ],
  "packageManager": "npm@12.2.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
